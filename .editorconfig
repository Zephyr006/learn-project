# 告诉EditorConfig插件，这是根文件，不用继续往上查找
root = true


# 匹配全部文件
[*.{groovy,java,kt}]
charset = utf-8
end_of_line = lf
indent_style = space
# indent_size = 4
# 在文件结尾插入新行
insert_final_newline = true
# 删除一行中的前后空格
trim_trailing_whitespace = true
# 运算符两边都有空格
spaces_around_operators = true
# 在指定的字符数后强制硬换行
max_line_length = 135

[*.{xml}]
indent_size = 4
insert_final_newline = false

# 以下匹配，类同
[*.{js,properties}]
indent_size = 2
insert_final_newline = false
